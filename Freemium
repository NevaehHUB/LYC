end

local function CreateSelector(name, optionsList, updateStateCallback)
	local Frame = Instance.new("Frame")
	Frame.Size = UDim2.new(1, 0, 0, 55)
	Frame.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
	Frame.Parent = ScrollFrame
	Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 6)
	
	local Label = Instance.new("TextLabel")
	Label.Size = UDim2.new(1, 0, 0, 20)
	Label.Position = UDim2.new(0, 10, 0, 5)
	Label.BackgroundTransparency = 1
	Label.Text = name
	Label.TextColor3 = Color3.fromRGB(200, 200, 200)
	Label.Font = Enum.Font.GothamSemibold
	Label.TextSize = 12
	Label.TextXAlignment = Enum.TextXAlignment.Left
	Label.Parent = Frame
	
	local LeftBtn = Instance.new("TextButton")
	LeftBtn.Size = UDim2.new(0, 30, 0, 25)
	LeftBtn.Position = UDim2.new(0, 10, 0, 25)
	LeftBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
	LeftBtn.Text = "<"
	LeftBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	LeftBtn.Font = Enum.Font.GothamBold
	LeftBtn.Parent = Frame
	Instance.new("UICorner", LeftBtn).CornerRadius = UDim.new(0, 4)
	
	local RightBtn = Instance.new("TextButton")
	RightBtn.Size = UDim2.new(0, 30, 0, 25)
	RightBtn.Position = UDim2.new(1, -40, 0, 25)
	RightBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
	RightBtn.Text = ">"
	RightBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	RightBtn.Font = Enum.Font.GothamBold
	RightBtn.Parent = Frame
	Instance.new("UICorner", RightBtn).CornerRadius = UDim.new(0, 4)
	
	local Display = Instance.new("TextLabel")
	Display.Size = UDim2.new(1, -90, 0, 25)
	Display.Position = UDim2.new(0, 45, 0, 25)
	Display.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
	Display.Text = optionsList[1]
	Display.TextColor3 = Color3.fromRGB(255, 255, 255)
	Display.Font = Enum.Font.Gotham
	Display.TextSize = 13
	Display.Parent = Frame
	Instance.new("UICorner", Display).CornerRadius = UDim.new(0, 4)
	
	local index = 1
	LeftBtn.MouseButton1Click:Connect(function()
		index = index - 1
		if index < 1 then index = #optionsList end
		Display.Text = optionsList[index]
		updateStateCallback(optionsList[index])
	end)
	
	RightBtn.MouseButton1Click:Connect(function()
		index = index + 1
		if index > #optionsList then index = 1 end
		Display.Text = optionsList[index]
		updateStateCallback(optionsList[index])
	end)
end

