-- ===== AUTOMATION LOOPS =====
local function StartAutoBuyCrates()
	if State.Threads.BuyCrates then return end
	State.AutoBuyCrates = true
	State.Threads.BuyCrates = task.spawn(function()
		while State.AutoBuyCrates do
			SafeFire(Remotes.BuyCrateEvent, State.SelectedCrate)
			SafeFire(Remotes.BuyCrateEvent, {Name = State.SelectedCrate, Amount = 1})
			task.wait(1)
		end
		State.Threads.BuyCrates = nil
	end)
end

local function StartAutoMinigame()
	if State.Threads.Minigame then return end
	State.AutoMinigame = true
	State.Threads.Minigame = task.spawn(function()
		while State.AutoMinigame do
			SafeFire(Remotes.EmoteEvent, State.SelectedMinigame)
			SafeFire(Remotes.MIH, "StartMinigame", State.SelectedMinigame)
			task.wait(5)
		end
		State.Threads.Minigame = nil
	end)
end

local function StartAutoRebirth()
	if State.Threads.Rebirth then return end
	State.AutoRebirth = true
	State.Threads.Rebirth = task.spawn(function()
		while State.AutoRebirth do
			SafeFire(Remotes.RebirthEvent)
			SafeFire(Remotes.RebirthEvent, true)
			task.wait(2)
		end
		State.Threads.Rebirth = nil
	end)
end

local function StartAutoTitles()
	if State.Threads.Titles then return end
	State.AutoTitles = true
	State.Threads.Titles = task.spawn(function()
		while State.AutoTitles do
			SafeFire(Remotes.TradeTitleEvent, "ClaimAll")
			SafeInvoke(Remotes.ClaimIndexReward, "All")
			task.wait(10)
		end
		State.Threads.Titles = nil
	end)
end

local function StartAutoClaimRewards()
	if State.Threads.Rewards then return end
	State.AutoClaimRewards = true
	State.Threads.Rewards = task.spawn(function()
		while State.AutoClaimRewards do
			SafeInvoke(Remotes.ClaimReward)
			SafeInvoke(Remotes.ClaimFollowBoost)
			SafeInvoke(Remotes.ClaimCashRunOrb)
			SafeInvoke(Remotes.ClaimGemRunOrb)
			task.wait(30)
		end
		State.Threads.Rewards = nil
	end)
end

