local function SafeFire(remote, ...)
	if not remote then return false end
	local s, r = pcall(function() return remote:FireServer(...) end)
	return s
end

local function SafeInvoke(remote, ...)
	if not remote then return false end
	local s, r = pcall(function() return remote:InvokeServer(...) end)
	return s
end

-- ===== AUTOMATION FUNCTIONS =====
local function StartAutoBuyCrates()
	if State.Threads.BuyCrates then return end
	State.AutoBuyCrates = true
	State.Threads.BuyCrates = task.spawn(function()
		while State.AutoBuyCrates do
			local price = State.CratePrices[State.SelectedCrate] or 100
			SafeFire(Remotes.BuyCrateEvent, State.SelectedCrate)
			SafeFire(Remotes.BuyCrateEvent, {Name = State.SelectedCrate, Amount = 1})
			task.wait(1)
		end
		State.Threads.BuyCrates = nil
	end)
end

local function StartAutoMinigame()
	if State.Threads.Minigame then return end
	State.AutoMinigame = true
	State.Threads.Minigame = task.spawn(function()
		while State.AutoMinigame do
			SafeFire(Remotes.EmoteEvent, State.SelectedMinigame)
			SafeFire(Remotes.MIH, "StartMinigame", State.SelectedMinigame)
			task.wait(5)
		end
		State.Threads.Minigame = nil
	end)
end

local function StartAutoRebirth()
	if State.Threads.Rebirth then return end
