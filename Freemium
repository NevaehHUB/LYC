-- ===== REMOTES SETUP =====
local Remotes = {}
local function GetRemote(name, className)
	className = className or "RemoteEvent"
	local remote = ReplicatedStorage:FindFirstChild(name)
	if not remote then
		remote = ReplicatedStorage:WaitForChild(name, 2) -- Reduced wait time to prevent hanging
	end
	if remote and remote:IsA(className) then
		Remotes[name] = remote
		return remote
	end
	return nil
end

