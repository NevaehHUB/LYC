-- ===== REMOTES SETUP =====
local Remotes = {}
local function GetRemote(name, className)
	className = className or "RemoteEvent"
	local remote = ReplicatedStorage:FindFirstChild(name) or ReplicatedStorage:WaitForChild(name, 2)
	if remote and remote:IsA(className) then
		Remotes[name] = remote
		return remote
	end
	return nil
end

GetRemote("BuyCrateEvent")
GetRemote("RebirthEvent")
GetRemote("TradeTitleEvent")
GetRemote("EmoteEvent")
GetRemote("PurchaseEvent")
GetRemote("MIH")
GetRemote("ClaimReward", "RemoteFunction")
GetRemote("ClaimIndexReward", "RemoteFunction")
GetRemote("CheckIndexRewards", "RemoteFunction")
GetRemote("ClaimFollowBoost", "RemoteFunction")
GetRemote("ClaimCashRunOrb", "RemoteFunction")
GetRemote("ClaimGemRunOrb", "RemoteFunction")

local function SafeFire(remote, ...)
	if not remote then return false end
	local s = pcall(function() remote:FireServer(...) end)
	return s
end

local function SafeInvoke(remote, ...)
	if not remote then return false end
	local s = pcall(function() remote:InvokeServer(...) end)
	return s
end

